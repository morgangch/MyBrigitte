FROM oven/bun:1.4.3-alpine

WORKDIR /app

# Seeds a fresh node_modules volume; sources come from the bind mount.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

EXPOSE 5173
# Reinstalling on start keeps an existing node_modules volume in sync with bun.lock.
CMD ["sh", "-c", "bun install --frozen-lockfile && exec bun run dev -- --host 0.0.0.0 --port 5173 --strictPort"]
