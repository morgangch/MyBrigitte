# Keep separate database/JWT/Microsoft credentials for each environment.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mybrigitte_prod
# Use URL-safe passwords because DATABASE_URL interpolates them.
POSTGRES_PASSWORD=replace_with_random_production_password
POSTGRES_DB=mybrigitte_prod
DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB
PORT=3001
JWT_SECRET=replace_with_distinct_random_production_secret
WEB_PORT=80
WEB_BIND_ADDRESS=127.0.0.1

# Microsoft OAuth: distinct applications and secrets for dev / production.
MICROSOFT_APP_ID=
MICROSOFT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:$WEB_PORT/api/auth/microsoft/callback

# Optional release images (immutable digests recommended).
# BACKEND_IMAGE=ghcr.io/morgangch/mybrigitte/backend@sha256:...
# WEB_IMAGE=ghcr.io/morgangch/mybrigitte/web@sha256:...
# PROXY_IMAGE=ghcr.io/morgangch/mybrigitte/proxy@sha256:...
